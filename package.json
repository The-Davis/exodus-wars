{
  "name": "exodus-wars",
  "version": "1.0.0",
  "private": true,
  "description": "A TypeScript-based Galactic Codex and Starmap for the Exodus Wars universe.",
  "scripts": {
    "dev": "concurrently --names \"vite,test,lint\" --prefix-colors \"cyan,yellow,magenta\" \"vite\" \"vitest\" \"yarn check:watch\"",
    "build": "tsc --noEmit && eslint src && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "check:watch": "chokidar \"src/**/*.ts\" -c \"eslint src\" --initial"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/The-Davis/exodus-wars.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/The-Davis/exodus-wars/issues"
  },
  "homepage": "https://github.com/The-Davis/exodus-wars#readme",
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^9.2.1",
    "eslint": "^10.2.0",
    "jsdom": "^29.0.2",
    "typescript": "^6.0.2",
    "vite": "^6.3.2",
    "vitest": "3"
  }
}
